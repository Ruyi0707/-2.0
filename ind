function buildSections(){
  const wrap = document.getElementById('questionsWrap');
  let globalQNum = 0;
  sections.forEach((sec, secIdx) => {
    const el = document.createElement('div');
    el.className = 'section';
    el.id = sec.id;
    let html = `<div class="section-head"><h2>${sec.title}</h2><p>${sec.desc}</p></div>`;
    sec.questions.forEach(q => {
      globalQNum++;
      const qKey = `q_${q.id}`;
      if(q.dir === 'scenario'){
        html += `<div class="question"><div class="q-num">Q${globalQNum}</div><div class="scenario-wrap"><div class="scenario-desc">${q.text}</div><div class="scenario-opts"><div class="scenario-opt"><input type="radio" name="${qKey}" id="${qKey}_A" value="A"><label for="${qKey}_A">A. ${q.optA}</label></div><div class="scenario-opt"><input type="radio" name="${qKey}" id="${qKey}_B" value="B"><label for="${qKey}_B">B. ${q.optB}</label></div></div></div></div>`;
      } else {
        html += `<div class="question"><div class="q-num">Q${globalQNum}</div><div class="q-text">${q.text}</div><div class="circles"><span class="side-label left">非常符合</span><div class="circle-group">${[5,4,3,2,1].map(v => {const sz = v===5||v===1?'s1':v===4||v===2?'s2':'s3';return `<label class="circle-opt"><input type="radio" name="${qKey}" value="${v}"><span class="dot ${sz}"></span></label>`;}).join('')}</div><span class="side-label right">非常不符合</span></div></div>`;
      }
    });
    html += `<div class="error-msg" id="err_${secIdx}">还有题目没答完哦～</div>`;
    html += `<div class="nav-row"><span class="step-info">${secIdx+1} / ${sections.length}</span><div>${secIdx > 0 ? `<button class="btn btn-sec" onclick="goSection(${secIdx-1})">上一部分</button> ` : ''}${secIdx < sections.length-1 ? `<button class="btn btn-main" onclick="nextSection(${secIdx})">下一部分</button>` : `<button class="btn btn-main" onclick="submitAll()">查看结果</button>`}</div></div>`;
    el.innerHTML = html;
    wrap.appendChild(el);
  });
}

function goSection(idx){
  document.querySelectorAll('.section').forEach(el=>el.classList.remove('active'));
  document.getElementById('atlasSection').classList.remove('active');
  document.getElementById('matchSection').classList.remove('active');
  document.getElementById(sections[idx].id).classList.add('active');
  currentSection=idx;
  window.scrollTo({top:0,behavior:'smooth'});
  updateProgress();
}
function isSectionDone(idx){
  for(const q of sections[idx].questions){
    const qKey=`q_${q.id}`;
    if(!document.querySelector(`input[name="${qKey}"]:checked`))return false;
  }
  return true;
}
function nextSection(idx){
  const err=document.getElementById(`err_${idx}`);
  if(!isSectionDone(idx)){err.style.display='block';return;}
  err.style.display='none';goSection(idx+1);
}
function submitAll(){
  const lastIdx=sections.length-1;
  const err=document.getElementById(`err_${lastIdx}`);
  if(!isSectionDone(lastIdx)){err.style.display='block';return;}
  for(let i=0;i<sections.length;i++){if(!isSectionDone(i)){goSection(i);document.getElementById(`err_${i}`).style.display='block';return;}}
  document.querySelectorAll('.section').forEach(el=>el.classList.remove('active'));
  document.getElementById('progressWrap').style.display='none';
  renderResults();
}
function updateProgress(){
  let done=0,total=0;
  sections.forEach(sec=>{sec.questions.forEach(q=>{total++;const qKey=`q_${q.id}`;if(document.querySelector(`input[name="${qKey}"]:checked`))done++;});});
  document.getElementById('progressFill').style.width=(done/total*100)+'%';
  document.getElementById('progressText').textContent=`${done} / ${total}`;
}

