function typeName(code){
  return `${code} ${typeProfiles[code].nickname}`;
}

function renderMatchChips(codes, fallback=''){
  if(!codes || !codes.length) return `<span class="match-chip">${fallback}</span>`;
  return codes.map(code=>`<span class="match-chip">${typeName(code)}</span>`).join('');
}

