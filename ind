  document.getElementById('resultSection').classList.remove('active');
  document.getElementById('matchSection').classList.remove('active');
  const atlas=document.getElementById('atlasSection');
  atlas.innerHTML=`<div class="atlas-card">${renderAtlasHtml(activeCode)}</div>`;
  atlas.classList.add('active');
  window.scrollTo({top:0,behavior:'smooth'});
}

function backFromAtlas(){
  document.getElementById('atlasSection').classList.remove('active');
  document.getElementById('resultSection').classList.add('active');
  window.scrollTo({top:0,behavior:'smooth'});
}

function showMatchTable(activeCode=''){
  document.getElementById('introSection').style.display='none';
  document.querySelectorAll('.section').forEach(el=>el.classList.remove('active'));
  document.getElementById('progressWrap').style.display='none';
  document.getElementById('resultSection').classList.remove('active');
  document.getElementById('atlasSection').classList.remove('active');
  const match=document.getElementById('matchSection');
  match.innerHTML=`<div class="atlas-card">${renderMatchTableHtml(activeCode)}</div>`;
  match.classList.add('active');
  window.scrollTo({top:0,behavior:'smooth'});
}

function backFromMatchTable(){
  document.getElementById('matchSection').classList.remove('active');
  document.getElementById('resultSection').classList.add('active');
  window.scrollTo({top:0,behavior:'smooth'});
}
function getVal(qId){const el=document.querySelector(`input[name="q_${qId}"]:checked`);return el?el.value:null;}
function scoreQ(qId,dir){const v=getVal(qId);if(v===null)return 0;if(dir==='scenario')return v==='A'?5:1;const num=Number(v);return dir==='R'?(6-num):num;}

function renderResults(){
  const scores={ER:0,CR:0,IP:0,RN:0,RE:0,CM:0,RF:0};
  const counts={ER:0,CR:0,IP:0,RN:0,RE:0,CM:0,RF:0};
  sections.forEach(sec=>{sec.questions.forEach(q=>{if(q.dir==='M')return;const s=scoreQ(q.id,q.dir);if(scores[q.dim]!==undefined){scores[q.dim]+=s;counts[q.dim]++;}});});

  const ipMax=counts.IP*5,rnMax=counts.RN*5,reMax=counts.RE*5,erMax=counts.ER*5,crMax=counts.CR*5,cmMax=counts.CM*5,rfMax=counts.RF*5;
  const ipMid=ipMax/2,rnMid=rnMax/2,reMid=reMax/2,cmMid=cmMax/2;

  const codeIP=scores.IP>=ipMid?'N':'I';
  const codeRN=scores.RN>=rnMid?'S':'A';
  const codeRE=scores.RE>=reMid?'E':'R';
  const codeCM=scores.CM>=cmMid?'T':'F';
  const typeCode=`${codeIP}${codeRN}${codeRE}`;
  const fullCode=`${typeCode}-${codeCM}`;
  const imgKey=`${typeCode}-${codeCM}`;
  const profile=typeProfiles[typeCode]||{nickname:'混合型',oneliner:'你的结果处于多个维度的中间区域',desc:'你的画像不属于典型的单一类型，但这不是问题——说明你在多个维度上都比较均衡。'};

  const erPct=scores.ER/erMax*100,crPct=scores.CR/crMax*100;
  const rfScores=[];
  ['R1','R2','R3'].forEach(rid=>{const v=getVal(rid);if(v)rfScores.push(6-Number(v));});
  const rfTotal=rfScores.reduce((a,b)=>a+b,0);

  const risks=[];
  if(erPct<50)risks.push({title:'情绪调节',level:'high',desc:'你的情绪调节能力可能是关系中的风险点。情绪来的时候较难控制行为反应，或者恢复时间较长。'});
  else if(erPct<65)risks.push({title:'情绪调节',level:'mid',desc:'你的情绪调节能力整体中等。大部分时候能控制，但压力大时可能会失控。'});
  else risks.push({title:'情绪调节',level:'low',desc:'你的情绪调节能力较好。'});

  if(crPct<50)risks.push({title:'冲突修复',level:'high',desc:'冲突后的修复可能是你在关系中的短板。你可能倾向于冷处理、等对方先来、或者在冲突中升级。'});
  else if(crPct<65)risks.push({title:'冲突修复',level:'mid',desc:'你的冲突修复能力整体中等。'});
  else risks.push({title:'冲突修复',level:'low',desc:'你在冲突后的修复能力较强。'});

  if(rfTotal>=rfMax*0.7)risks.push({title:'控制倾向提示',level:'high',desc:'你的部分回答显示出较强的控制或占有倾向。如果对方重视自主性，可能会产生摩擦。'});
  else if(rfTotal>=rfMax*0.5)risks.push({title:'控制倾向提示',level:'mid',desc:'你有一定的控制意识，但整体在正常范围内。'});

  const dimDisplay=[
    {key:'ER',name:'情绪调节',score:scores.ER,max:erMax,color:'#c026d3',high:'调节能力强',low:'调节能力弱'},
    {key:'CR',name:'冲突修复',score:scores.CR,max:crMax,color:'#0891b2',high:'修复能力强',low:'修复能力弱'},
    {key:'IP',name:'亲密距离',score:scores.IP,max:ipMax,color:'#ea580c',high:'偏亲近',low:'偏独立'},
    {key:'RN',name:'确认需求',score:scores.RN,max:rnMax,color:'#2563eb',high:'安全感稳定',low:'确认需求较高'},
    {key:'RE',name:'回应表达',score:scores.RE,max:reMax,color:'#16a34a',high:'表达充分',low:'表达内敛'},
  ];

  const imgSrc = IMG_DATA[imgKey] || '';
  const commTip = COMM_TIPS[codeCM];
  const reportText = generateReport(fullCode,profile,dimDisplay,scores,cmMax,codeCM,risks,commTip);

  const rs=document.getElementById('resultSection');
  rs.innerHTML=`
    <div class="result-card">
      <div class="type-hero">
        ${imgSrc ? `<img class="type-img" src="${imgSrc}" alt="${fullCode}">` : ''}
        <div class="type-info">
          <div class="type-badge">${fullCode}</div>
          <div class="type-nickname">${profile.nickname}</div>
          <div class="type-oneliner">${profile.oneliner}</div>
          <div class="tags">
            <span class="tag">${codeIP==='N'?'亲近端':'独立端'}</span>
            <span class="tag">${codeRN==='S'?'安全感稳定':'确认需求较高'}</span>
            <span class="tag">${codeRE==='E'?'表达充分':'表达内敛'}</span>
            <span class="tag">沟通：${codeCM==='T'?'偏分析':'偏共感'}</span>
          </div>
          <div class="link-row">
            <a class="text-link" href="#personality-atlas" onclick="showAtlas('${fullCode}');return false;">查看人格图鉴</a>
            <a class="text-link" href="#match-table" onclick="showMatchTable('${typeCode}');return false;">匹配建议表</a>
          </div>
        </div>
      </div>
      <div class="type-desc-text" style="margin-top:20px;padding:18px;background:#fafaf8;border-radius:14px">${profile.desc}</div>
    </div>
    <div class="result-card">
      <h2 style="font-size:18px;font-weight:700;margin-bottom:12px">匹配度建议</h2>
      ${renderMatchSummaryHtml(typeCode)}
    </div>
    <div class="result-card">
      <h2 style="font-size:18px;font-weight:700;margin-bottom:12px">沟通风格提示</h2>
      ${renderCommTipHtml(codeCM)}
    </div>
    <div class="result-card">
      <h2 style="font-size:18px;font-weight:700;margin-bottom:4px">各维度得分</h2>
      <div class="dim-scores">
        ${dimDisplay.map(d=>{const pct=Math.round(d.score/d.max*100);return `<div class="dim-card"><h4>${d.name}</h4><div class="score-val">${d.score} / ${d.max}　·　${pct>=60?d.high:pct<=40?d.low:'中间区'}</div><div class="meter"><span style="width:${pct}%;background:${d.color}"></span></div></div>`;}).join('')}
        <div class="dim-card"><h4>认知沟通</h4><div class="score-val">${scores.CM} / ${cmMax}　·　${codeCM==='T'?'偏分析型（T）':'偏共感型（F）'}</div><div class="meter"><span style="width:${Math.round(scores.CM/cmMax*100)}%;background:#b45309"></span></div></div>
      </div>
    </div>
    <div class="result-card">
      <h2 style="font-size:18px;font-weight:700;margin-bottom:4px">风险与提示</h2>
      <div class="risk-section">${risks.map(r=>`<div class="risk-item ${r.level}"><strong>${r.title}：${r.level==='high'?'需要关注':r.level==='mid'?'中等':'良好'}</strong><p>${r.desc}</p></div>`).join('')}</div>
    </div>
    <div class="result-card report-box">
      <div class="report-head">
        <div>
          <div class="report-title">文字报告</div>
          <div class="report-sub">RMS 恋爱匹配筛选系统 · 测试结果</div>
        </div>
        <div class="report-pill">${fullCode}</div>
      </div>
      <div class="report-summary">
        <div class="report-kv"><span>人格昵称</span><strong>${profile.nickname}</strong></div>
        <div class="report-kv"><span>亲密距离</span><strong>${codeIP==='N'?'亲近端':'独立端'}</strong></div>
        <div class="report-kv"><span>安全感</span><strong>${codeRN==='S'?'稳定':'敏感'}</strong></div>
        <div class="report-kv"><span>沟通风格</span><strong>${codeCM==='T'?'偏分析':'偏共感'}</strong></div>
      </div>
      <div class="report-section">
        <h3>类型描述</h3>
        <div class="report-body">${profile.desc}</div>
      </div>
      <div class="report-section">
        <h3>各维度得分</h3>
        <div class="report-list">
          ${dimDisplay.map(d=>{const pct=Math.round(d.score/d.max*100);return `<div class="report-row"><div class="report-row-name">${d.name}</div><div class="report-row-meta">${d.score} / ${d.max} · ${pct}% · ${pct>=60?d.high:pct<=40?d.low:'中间区'}</div></div>`;}).join('')}
          <div class="report-row"><div class="report-row-name">认知沟通</div><div class="report-row-meta">${scores.CM} / ${cmMax} · ${codeCM==='T'?'偏分析型':'偏共感型'}</div></div>
        </div>
      </div>
      <div class="report-section">
        <h3>风险提示</h3>
        ${risks.map(r=>`<div class="report-risk ${r.level}"><strong>${r.title}：${r.level==='high'?'需要关注':r.level==='mid'?'中等':'良好'}</strong><p>${r.desc}</p></div>`).join('')}
      </div>
      <textarea id="reportText" class="sr-report-text" readonly>${reportText}</textarea>
      <div class="actions-row">
        <button class="btn btn-sec" onclick="copyReport()">复制报告</button>
        <button class="btn btn-sec" onclick="restart()">重新测试</button>
      </div>
      <p style="font-size:12px;color:#bbb;margin-top:12px">你可以把这个 HTML 文件直接发给对方做测试，然后对比两人的结果。</p>
    </div>`;
  rs.classList.add('active');
  window.scrollTo({top:0,behavior:'smooth'});
}

function generateReport(code,profile,dims,scores,cmMax,cm,risks,commTip){
  let r=[`RMS 恋爱匹配筛选系统 · 测试结果`,`${'═'.repeat(36)}`,``,`类型编码：${code}`,`昵称：${profile.nickname}`,``,`── 类型描述 ──`,profile.desc,``,`── 各维度得分 ──`];
  dims.forEach(d=>{const pct=Math.round(d.score/d.max*100);r.push(`${d.name}：${d.score}/${d.max}（${pct}%）→ ${pct>=60?d.high:pct<=40?d.low:'中间区'}`);});
  r.push(`认知沟通：${scores.CM}/${cmMax} → ${cm==='T'?'偏分析型':'偏共感型'}`);
  r.push(``);r.push(`── ${commTip.title} ──`);
  r.push(commTip.intro);
  r.push(``);
  r.push(`恋爱前建议：`);
  r.push(`优先了解：${commTip.priority}`);
  r.push(`可以聊聊：${commTip.chat}`);
  r.push(`谨慎进入：${commTip.caution}`);
  r.push(``);
  r.push(`一句话：${commTip.line}`);
  r.push(``);r.push(`── 风险提示 ──`);
  risks.forEach(ri=>r.push(`${ri.title}：${ri.desc}`));
  r.push(``);r.push(`提示：这份结果适合做前筛和关系画像参考，不适合当作绝对判断。`);
  return r.join('\n');
}
function copyReport(){const t=document.getElementById('reportText');try{navigator.clipboard.writeText(t.value);alert('已复制到剪贴板');}catch(e){t.style.position='fixed';t.style.left='0';t.style.top='0';t.style.opacity='1';t.select();document.execCommand('copy');t.className='sr-report-text';alert('已复制到剪贴板');}}
function restart(){document.querySelectorAll('input[type="radio"]').forEach(i=>i.checked=false);document.querySelectorAll('.section').forEach(el=>el.classList.remove('active'));document.getElementById('atlasSection').classList.remove('active');document.getElementById('atlasSection').innerHTML='';document.getElementById('matchSection').classList.remove('active');document.getElementById('matchSection').innerHTML='';document.getElementById('resultSection').classList.remove('active');document.getElementById('resultSection').innerHTML='';document.getElementById('introSection').style.display='block';document.getElementById('progressWrap').style.display='none';updateProgress();window.scrollTo({top:0,behavior:'smooth'});}

buildSections();
function startTest(){document.getElementById('atlasSection').classList.remove('active');document.getElementById('matchSection').classList.remove('active');document.getElementById('resultSection').classList.remove('active');document.getElementById('introSection').style.display='none';document.getElementById('progressWrap').style.display='block';goSection(0);}
document.addEventListener('change',e=>{if(e.target.matches('input[type="radio"]'))updateProgress();});
</script>
